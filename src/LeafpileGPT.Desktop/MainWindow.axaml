<Window xmlns="https://github.com/avaloniaui"
        xmlns:local="using:LeafpileGPT.Desktop"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LeafpileGPT.Desktop.MainWindow"
        Title="LeafpileGPT"
        Width="960"
        Height="640">
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu Grid.Row="0" Background="White" Foreground="#111111">
      <MenuItem Header="_File">
        <MenuItem x:Name="PlayGameMenuItem" Header="Play Game..." Click="OnPlayGameClick" />
        <Separator />
        <MenuItem x:Name="SaveMenuItem" Header="Save..." Click="OnSaveClick" IsEnabled="False" />
        <MenuItem x:Name="RestoreMenuItem" Header="Restore..." Click="OnRestoreClick" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="RestartMenuItem" Header="Restart" Click="OnRestartClick" IsEnabled="False" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Tools" />
    </Menu>
    <local:GameDisplayView x:Name="GameDisplay" Grid.Row="1" />
    <Border Grid.Row="2" Padding="8" BorderThickness="0,1,0,0" Background="#E5E5E5">
      <TextBlock x:Name="AppStatusText" Text="No story loaded." Foreground="#202020" />
    </Border>
  </Grid>
</Window>
