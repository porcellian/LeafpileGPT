<Window xmlns="https://github.com/avaloniaui"
        xmlns:local="using:LeafpileGPT.Desktop"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LeafpileGPT.Desktop.MainWindow"
        Title="LeafpileGPT"
        Width="960"
        Height="680">
  <Grid RowDefinitions="Auto,*,Auto">
    <Menu Grid.Row="0" Background="White" Foreground="#111111">
      <MenuItem Header="_File">
        <MenuItem x:Name="PlayGameMenuItem" Header="Play Game..." Click="OnPlayGameClick" />
        <Separator />
        <MenuItem x:Name="SaveMenuItem" Header="Save..." Click="OnSaveClick" IsEnabled="False" />
        <MenuItem x:Name="RestoreMenuItem" Header="Restore..." Click="OnRestoreClick" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="RestartMenuItem" Header="Restart" Click="OnRestartClick" IsEnabled="False" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="StoryFileInfoMenuItem" Header="Story File Info..." Click="OnStoryFileInfoClick" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="ViewInstructionsMenuItem" Header="View Instructions..." Click="OnViewInstructionsClick" />
        <Separator />
        <MenuItem x:Name="ViewErrorsMenuItem" Header="View Errors..." Click="OnViewErrorsClick" />
        <Separator />
        <MenuItem Header="Runtime Error Policy">
          <MenuItem x:Name="SuppressErrorsMenuItem" Header="Suppress reports" Click="OnSuppressErrorsClick" />
          <MenuItem x:Name="FirstErrorMenuItem" Header="Report first of each type" Click="OnFirstErrorClick" />
          <MenuItem x:Name="EveryErrorMenuItem" Header="Report every occurrence" Click="OnEveryErrorClick" />
          <MenuItem x:Name="StopOnErrorMenuItem" Header="Stop on any error" Click="OnStopOnErrorClick" />
        </MenuItem>
      </MenuItem>
    </Menu>
    <local:GameDisplayView x:Name="GameDisplay" Grid.Row="1" />
    <Border Grid.Row="2" Padding="8" BorderThickness="0,1,0,0" Background="#E5E5E5">
      <TextBlock x:Name="AppStatusText" Text="No story loaded." Foreground="#202020" />
    </Border>
  </Grid>
</Window>
