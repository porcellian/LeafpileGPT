<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:LeafpileGPT.Desktop"
             x:Class="LeafpileGPT.Desktop.GameDisplayView"
             x:DataType="desktop:GameDisplayModel">
  <Grid RowDefinitions="Auto,*" Background="#0066CC">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="32" Background="#E5E5E5">
      <TextBlock Grid.Column="0"
                 Margin="12,4"
                 Text="{Binding Location}"
                 FontFamily="Courier New, Courier, monospace"
                 FontSize="16"
                 Foreground="#0066CC"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Margin="12,4"
                 Text="{Binding RightStatus}"
                 IsVisible="{Binding HasStoryLoaded}"
                 FontFamily="Courier New, Courier, monospace"
                 FontSize="16"
                 Foreground="#0066CC"
                 TextAlignment="Right"
                 VerticalAlignment="Center" />
    </Grid>
    <Grid x:Name="PlayArea" Grid.Row="1" RowDefinitions="Auto,*" Background="#0066CC" ClipToBounds="True">
      <Border x:Name="UpperWindowBorder" Grid.Row="0" Padding="0"
              IsVisible="{Binding IsUpperWindowVisible}"
              ClipToBounds="True"
              Background="#0066CC">
        <TextBlock x:Name="UpperWindowTextBlock"
                   Text="{Binding UpperWindowText}"
                   FontFamily="Courier New, Courier, monospace"
                   FontSize="20"
                   Foreground="White"
                   TextWrapping="NoWrap" />
      </Border>
      <Grid Grid.Row="1" ClipToBounds="True">
        <ScrollViewer x:Name="TranscriptScrollViewer"
                      Padding="8"
                      Background="#0066CC"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Grid MinHeight="{Binding Viewport.Height, ElementName=TranscriptScrollViewer}">
            <TextBlock x:Name="TranscriptTextBlock"
                       FontFamily="Courier New, Courier, monospace"
                       FontSize="20"
                       Foreground="White"
                       TextWrapping="Wrap"
                       VerticalAlignment="Bottom" />
          </Grid>
        </ScrollViewer>
        <Canvas x:Name="PictureCanvas" IsHitTestVisible="False" />
        <TextBox x:Name="PromptTextBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Bottom"
                 Height="28"
                 Margin="8"
                 Text="{Binding InputText, Mode=TwoWay}"
                 FontFamily="Courier New, Courier, monospace"
                 FontSize="20"
                 Foreground="Transparent"
                 Opacity="0"
                 CaretBrush="Transparent"
                 SelectionBrush="Transparent"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 FocusAdorner="{x:Null}"
                 Padding="0"
                 VerticalContentAlignment="Center"
                 KeyDown="OnPromptKeyDown" />
        <TextBlock Text="[MORE]"
                   IsVisible="{Binding IsMorePromptVisible}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="8"
                   Padding="2,0"
                   Background="#0066CC"
                   Foreground="White"
                   FontWeight="Bold"
                   FontFamily="Courier New, Courier, monospace"
                   FontSize="20"
                   IsHitTestVisible="False" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
