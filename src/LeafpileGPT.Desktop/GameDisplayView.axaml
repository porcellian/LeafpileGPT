<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:LeafpileGPT.Desktop"
             x:Class="LeafpileGPT.Desktop.GameDisplayView"
             x:DataType="desktop:GameDisplayModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="#0066CC">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="32" Background="#E5E5E5">
      <TextBlock Grid.Column="0"
                 Margin="12,4"
                 Text="{Binding Location}"
                 FontFamily="Courier New, Courier, monospace"
                 FontSize="16"
                 Foreground="#0066CC"
                 TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Margin="12,4"
                 Text="{Binding RightStatus}"
                 FontFamily="Courier New, Courier, monospace"
                 FontSize="16"
                 Foreground="#0066CC"
                 TextAlignment="Right"
                 VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Background="#0066CC">
      <Border Grid.Row="0" Padding="8"
              IsVisible="{Binding IsUpperWindowVisible}"
              Background="#0066CC">
        <TextBlock Text="{Binding UpperWindowText}"
                   FontFamily="Courier New, Courier, monospace"
                   FontSize="20"
                   Foreground="White"
                   TextWrapping="Wrap" />
      </Border>
      <Grid Grid.Row="1" ClipToBounds="True">
        <ScrollViewer x:Name="TranscriptScrollViewer"
                      Padding="8"
                      Background="#0066CC"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="TranscriptTextBlock"
                     FontFamily="Courier New, Courier, monospace"
                     FontSize="20"
                     Foreground="White"
                     TextWrapping="Wrap"
                     VerticalAlignment="Bottom" />
        </ScrollViewer>
        <Canvas x:Name="PictureCanvas" IsHitTestVisible="False" />
      </Grid>
    </Grid>
    <Border Grid.Row="2" Padding="8,4,8,8" Background="#0066CC">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding PromptText}"
                   Margin="0,0,2,0"
                   FontFamily="Courier New, Courier, monospace"
                   FontSize="20"
                   Foreground="White"
                   VerticalAlignment="Center" />
        <Grid Grid.Column="1">
          <TextBox x:Name="PromptTextBox"
                   Text="{Binding InputText, Mode=TwoWay}"
                   FontFamily="Courier New, Courier, monospace"
                   FontSize="20"
                   Foreground="Transparent"
                   CaretBrush="Transparent"
                   SelectionBrush="Transparent"
                   Background="Transparent"
                   BorderBrush="Transparent"
                   BorderThickness="0"
                   FocusAdorner="{x:Null}"
                   Padding="0"
                   VerticalContentAlignment="Center"
                   KeyDown="OnPromptKeyDown" />
          <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
            <TextBlock x:Name="PromptInputTextBlock"
                       FontFamily="Courier New, Courier, monospace"
                       FontSize="20"
                       Foreground="White"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="BlockCursor"
                       Text="█"
                       FontFamily="Courier New, Courier, monospace"
                       FontSize="20"
                       Foreground="White"
                       IsVisible="False"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
