<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Leafpile.Desktop.MainWindow"
        Title="LeafpileGPT"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="400"
        Background="#0066CC">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#FFFFFF">
      <MenuItem Header="_File">
        <MenuItem Header="_Open Story…" Click="OnOpenStory" />
        <Separator />
        <MenuItem Header="_Quit" Click="OnQuit" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="RestartMenuItem" Header="_Restart" Click="OnRestart" IsEnabled="False" />
        <MenuItem Header="Save and restore use the story's save and restore commands" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Keyboard: type a command and press Enter" IsEnabled="False" />
      </MenuItem>
    </Menu>
    <Border x:Name="StatusBar" DockPanel.Dock="Top" Background="#E5E5E5" Padding="10,5" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusLocationText" FontFamily="Courier New, monospace" Foreground="#0066CC" />
        <TextBlock x:Name="StatusValuesText" Grid.Column="1" HorizontalAlignment="Right"
                   FontFamily="Courier New, monospace" Foreground="#0066CC" />
      </Grid>
    </Border>
    <Grid x:Name="StorySurface" Background="#0066CC" Focusable="True">
      <TextBlock x:Name="UpperText" Margin="12,10" FontFamily="Courier New, monospace" FontSize="16"
                 Foreground="#FFFFFF" TextWrapping="NoWrap" VerticalAlignment="Top" />
      <TextBlock x:Name="LowerText" Margin="12,10" FontFamily="Courier New, monospace" FontSize="16"
                 Foreground="#FFFFFF" TextWrapping="NoWrap" VerticalAlignment="Bottom" />
      <Canvas x:Name="PictureCanvas" IsHitTestVisible="False" />
      <TextBlock x:Name="WelcomeText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="Open a story file to begin." FontSize="18" Foreground="#FFFFFF" />
      <TextBlock x:Name="RuntimeErrorText" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Foreground="#FFB0A8" FontWeight="Bold" TextWrapping="Wrap" IsVisible="False" />
    </Grid>
  </DockPanel>
</Window>
