  "intro": [
    "Begin with the available local Z4 release (release 77, serial 850814); the requested Z3 file was not present. The route uses a fresh story, deterministic seed 1, and 2,458,540 executed instructions.",
    "A Mind Forever Voyaging has no numeric score. This route records the needed future evidence, captures Senator Ryder threatening Perelman, disables Delta ventilation so the saboteurs are subdued, broadcasts the buffer, and reaches the New Plan ending.",
    "Deaths and assaults in the 2051-2081 sections happen inside simulations. Perry is killed in some futures; PRISM survives in the real facility, stops Ryder, and completes the final 2091 simulation."
  ],
  "checkpoints": [
    {
      "heading": "2071 EVIDENCE",
      "detail": "Church pamphlet and public events move Perelman\u2019s report forward."
    },
    {
      "heading": "2081 EVIDENCE",
      "detail": "Record the starving city, cemetery assault, bloody sack, and dog attack."
    },
    {
      "heading": "RYDER EXPOSED",
      "detail": "Record Ryder threatening Perelman during the lockdown."
    },
    {
      "heading": "PLAN DEFEATED",
      "detail": "WNN broadcast prompts the Guard recall and Perelman\u2019s victory message."
    },
    {
      "heading": "2091",
      "detail": "Read the New Plan newspaper; complete the Silver Dove voyage."
    }
  ],
  "endingVerification": "Perelman confirms that the broadcast exposed Ryder, the National Guard is recalled, and the Plan is dead in the water. The epilogue then allows the 2091 New Plan simulation; the route reads its newspaper and reaches the final voyage to the Silver Dove.",
  "stepStarts": {
    "1": "START FRESH | PRISM AWAKENS IN 2031",
    "14": "2041 | RECORD THE FIRST SIMULATION",
    "97": "2051 | SELECT THE 20-YEAR SIMULATION",
    "196": "2061 | SELECT THE 30-YEAR SIMULATION",
    "221": "2061 | REVISIT THE 30-YEAR SIMULATION",
    "397": "2061 | RETRY THE 30-YEAR SIMULATION",
    "419": "2071 | SELECT THE 40-YEAR SIMULATION",
    "523": "2071 | REVISIT THE 40-YEAR SIMULATION",
    "767": "2071 | RETRY THE 40-YEAR SIMULATION",
    "854": "2081 LOCKED | FALL BACK TO 2071",
    "877": "2081 | SELECT THE 50-YEAR SIMULATION",
    "985": "2081 | RECORD FINAL EVIDENCE",
    "1003": "REPORT FINAL EVIDENCE",
    "1024": "LOCKDOWN | RECORD RYDER",
    "1030": "STOP THE SABOTEURS",
    "1070": "2091 | NEW PLAN SIMULATION"
  },
  "routeNotes": {
    "180": [
      "Perelman needs evidence from additional future years; continue to the 30-year simulation."
    ],
    "350": [
      "The report still needs evidence from years beyond 2061; continue through the later simulations."
    ],
    "1005": [
      "Report the completed 2081 recordings to Perelman."
    ],
    "1010": [
      "Perelman accepts the evidence and says the Plan must be cancelled."
    ],
    "1025": [
      "After lockdown, record Ryder\u2019s threats before moving on."
    ],
    "1032": [
      "Disable only Delta ventilation; this fills the core with zeeron fumes."
    ],
    "1035": [
      "The saboteurs arrive on the rooftop and enter the stairwell."
    ],
    "1048": [
      "The four saboteurs pass out; leave ventilation off."
    ],
    "1055": [
      "A National Guard patrol removes the living saboteurs."
    ],
    "1063": [
      "The World News Network begins transmitting the recorded buffer."
    ],
    "1067": [
      "Perelman confirms Ryder is disgraced, the Guard recalled, and the Plan defeated."
    ],
    "1070": [
      "Enter the final 60-year simulation with security waived."
    ],
    "1072": [
      "The newspaper describes the better New Plan future."
    ],
    "1080": [
      "The final voyage concludes; the game reaches its acknowledgements."
    ]
  },
